# ============================================================
# DATABASE
# ============================================================
DATABASE_URL=postgresql://dev:dev_password@postgres:5432/ai_platform
DATABASE_ECHO=false

# ============================================================
# REDIS
# ============================================================
REDIS_URL=redis://redis:6379/0
REDIS_CACHE_TTL=3600

# ============================================================
# AWS / S3
# ============================================================
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=dev
AWS_SECRET_ACCESS_KEY=dev
S3_BUCKET_DOCUMENTS=documents-dev
S3_BUCKET_RECORDINGS=recordings-dev
S3_BUCKET_EXPORTS=exports-dev
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# ============================================================
# AUTHENTICATION & SECURITY
# ============================================================
SECRET_KEY=your-secret-key-change-in-production-min-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30
ALGORITHM=HS256

# ============================================================
# LLM PROVIDERS
# ============================================================
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2000

# OpenAI
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini

# Anthropic
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Google Gemini
GOOGLE_API_KEY=your-key-here
GOOGLE_MODEL=gemini-2.0-flash-exp

# Local LLM (vLLM, Ollama)
LOCAL_LLM_ENDPOINT=http://localhost:8000/v1
LOCAL_LLM_MODEL=mistral

# ============================================================
# TWILIO (VOICE & SMS)
# ============================================================
TWILIO_ACCOUNT_SID=your-sid-here
TWILIO_AUTH_TOKEN=your-token-here
TWILIO_PHONE_NUMBER=+1234567890

# ============================================================
# STRIPE (BILLING)
# ============================================================
STRIPE_API_KEY=sk_test_your-key-here
STRIPE_WEBHOOK_SECRET=whsec_your-secret-here

# ============================================================
# EMAIL
# ============================================================
SENDGRID_API_KEY=your-key-here
FROM_EMAIL=noreply@example.com
FROM_NAME=AI Platform

# ============================================================
# LOGGING & MONITORING
# ============================================================
LOG_LEVEL=INFO
ENVIRONMENT=development

# Sentry
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# ============================================================
# FRONTEND
# ============================================================
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_ENVIRONMENT=development

# ============================================================
# MOBILE
# ============================================================
EXPO_PUBLIC_API_URL=http://localhost:8000
EXPO_PUBLIC_ENVIRONMENT=development

# ============================================================
# FEATURES
# ============================================================
FEATURE_FLAG_VOICE_AI=true
FEATURE_FLAG_SMS_AI=true
FEATURE_FLAG_PRIVATE_AI=true
FEATURE_FLAG_WORKFLOWS=false
FEATURE_FLAG_ADVANCED_ANALYTICS=false
