project_id = "ai-platform-prod"
region      = "us-central1"
environment = "production"
app_name    = "ai-platform"

# Database configuration
database_version        = "15"
database_instance_type  = "db-n1-standard-2"

# Redis configuration
redis_memory_size = 4
redis_tier        = "STANDARD"

# Cloud Run - API configuration
api_memory        = 2048
api_cpu           = "4"
api_max_instances = 50

# Cloud Run - Web configuration
web_memory        = 1024
web_cpu           = "2"
web_max_instances = 30

# Ingress
allowed_ingress = "ALLOW_ALL"

# Labels
labels = {
  environment = "production"
  managed_by  = "terraform"
  team        = "platform"
}
